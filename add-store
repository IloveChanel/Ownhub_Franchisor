<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>OwnHub — Add / Upload Stores</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito+Sans:wght@400;600;700;800&family=Yellowtail&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="css/ownhub.css" />
</head>
<body>
  <div id="shell"></div>
  <main class="page">
    <div class="page-head">
      <div>
        <h1>Add / upload stores</h1>
        <p>Create one location, or drop a CSV to onboard a batch of franchisees.</p>
      </div>
    </div>

    <section class="panel">
      <h2>New store</h2>
      <p class="desc">A unique Store ID is generated from the location name. The franchisee uses that ID + PIN 1234 on the store POS.</p>
      <form id="form" class="form-grid" onsubmit="return addOne(event)">
        <div>
          <label>Location name</label>
          <input id="name" required placeholder="e.g. Shelby Township" />
        </div>
        <div>
          <label>Franchisee / manager</label>
          <input id="owner" required placeholder="Full name" />
        </div>
        <div class="full">
          <label>Address</label>
          <input id="address" required placeholder="Street, city, state, zip" />
        </div>
        <div>
          <label>Phone</label>
          <input id="phone" required placeholder="(586) 555-0100" />
        </div>
        <div>
          <label>Status</label>
          <select id="status">
            <option value="onboarding">Onboarding</option>
            <option value="live">Live</option>
            <option value="offline">Offline</option>
          </select>
        </div>
        <div class="full actions">
          <button class="btn btn-red btn-sm" type="submit">Create store + ID</button>
        </div>
      </form>
    </section>

    <section class="panel">
      <h2>Upload stores (CSV)</h2>
      <p class="desc">Columns: name, owner, address, phone, status. Store IDs are generated automatically. Header row required.</p>
      <div class="drop" id="drop">
        Drop CSV here or click to choose a file
        <input id="file" type="file" accept=".csv,text/csv" hidden />
      </div>
      <div id="preview" style="margin-top:14px"></div>
    </section>
  </main>
  <div class="toast" id="toast"></div>

  <script src="js/app.js"></script>
  <script>
    if (!OwnHub.requireAuth()) throw new Error("auth");
    document.getElementById("shell").innerHTML = OwnHub.header("add");

    function addOne(e) {
      e.preventDefault();
      const stores = OwnHub.loadStores();
      const rec = {
        id: OwnHub.generateStoreId(document.getElementById("name").value),
        name: document.getElementById("name").value.trim(),
        address: document.getElementById("address").value.trim(),
        phone: document.getElementById("phone").value.trim(),
        owner: document.getElementById("owner").value.trim(),
        status: document.getElementById("status").value,
        opened: new Date().toISOString().slice(0, 10),
        salesToday: 0, salesWeek: 0, openOrders: 0, royaltyDue: 0
      };
      stores.unshift(rec);
      OwnHub.saveStores(stores);
      OwnHub.toast("Created " + rec.id);
      e.target.reset();
      return false;
    }

    function parseCsv(text) {
      const lines = text.split(/\r?\n/).filter(l => l.trim());
      if (!lines.length) return [];
      const headers = lines[0].split(",").map(h => h.trim().toLowerCase());
      return lines.slice(1).map(line => {
        const cols = line.split(",").map(c => c.trim());
        const row = {};
        headers.forEach((h, i) => row[h] = cols[i] || "");
        return row;
      });
    }

    let pending = [];
    function showPreview(rows) {
      pending = rows.map(r => ({
        id: OwnHub.generateStoreId(r.name || r.location || "STORE"),
        name: r.name || r.location || "Untitled",
        owner: r.owner || r.franchisee || "TBD",
        address: r.address || "",
        phone: r.phone || "",
        status: (r.status || "onboarding").toLowerCase(),
        opened: new Date().toISOString().slice(0, 10),
        salesToday: 0, salesWeek: 0, openOrders: 0, royaltyDue: 0
      }));
      document.getElementById("preview").innerHTML = `
        <table>
          <thead><tr><th>Store ID</th><th>Name</th><th>Franchisee</th><th>Address</th><th>Status</th></tr></thead>
          <tbody>${pending.map(s => `<tr><td><span class="sid">${s.id}</span></td><td>${s.name}</td><td>${s.owner}</td><td>${s.address}</td><td>${s.status}</td></tr>`).join("")}</tbody>
        </table>
        <div class="actions" style="margin-top:12px">
          <button class="btn btn-green btn-sm" type="button" onclick="commitUpload()">Confirm ${pending.length} store(s)</button>
        </div>`;
    }

    function commitUpload() {
      const stores = OwnHub.loadStores();
      OwnHub.saveStores(pending.concat(stores));
      OwnHub.toast("Uploaded " + pending.length + " stores");
      pending = [];
      document.getElementById("preview").innerHTML = "";
    }

    const drop = document.getElementById("drop");
    const file = document.getElementById("file");
    drop.onclick = () => file.click();
    drop.ondragover = e => { e.preventDefault(); drop.classList.add("drag"); };
    drop.ondragleave = () => drop.classList.remove("drag");
    drop.ondrop = e => {
      e.preventDefault();
      drop.classList.remove("drag");
      const f = e.dataTransfer.files[0];
      if (f) f.text().then(t => showPreview(parseCsv(t)));
    };
    file.onchange = () => {
      const f = file.files[0];
      if (f) f.text().then(t => showPreview(parseCsv(t)));
    };
  </script>
</body>
</html>
