<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>OwnHub — Accounting</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito+Sans:wght@400;600;700;800&family=Yellowtail&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="css/ownhub.css" />
</head>
<body>
  <div id="shell"></div>
  <main class="page">
    <div class="page-head">
      <div>
        <h1>Accounting</h1>
        <p>Network rollup — royalties at 20% of today’s sales (demo rate).</p>
      </div>
      <button class="btn btn-wood btn-sm" type="button" onclick="downloadCsv()">Download CSV</button>
    </div>
    <div class="kpi-row" id="kpis"></div>
    <section class="panel">
      <h2>By location</h2>
      <p class="desc">Click a row to open that store’s own Export / Accounting page.</p>
      <div style="overflow-x:auto">
        <table>
          <thead>
            <tr>
              <th>Store ID</th>
              <th>Location</th>
              <th>Today</th>
              <th>Week</th>
              <th>Royalty due</th>
              <th>Open tickets</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody id="rows"></tbody>
        </table>
      </div>
    </section>
  </main>
  <script src="js/app.js"></script>
  <script>
    if (!OwnHub.requireAuth()) throw new Error("auth");
    document.getElementById("shell").innerHTML = OwnHub.header("accounting");
    const stores = OwnHub.loadStores();
    const today = stores.reduce((a, s) => a + s.salesToday, 0);
    const week = stores.reduce((a, s) => a + s.salesWeek, 0);
    const roy = stores.reduce((a, s) => a + s.royaltyDue, 0);

    document.getElementById("kpis").innerHTML = `
      <div class="kpi"><div class="lbl">Network today</div><div class="num">${OwnHub.money(today)}</div></div>
      <div class="kpi"><div class="lbl">Network week</div><div class="num">${OwnHub.money(week)}</div></div>
      <div class="kpi"><div class="lbl">Royalties due</div><div class="num">${OwnHub.money(roy)}</div><div class="sub">20% demo rate</div></div>
      <div class="kpi"><div class="lbl">Avg / live store</div><div class="num">${OwnHub.money(today / Math.max(1, stores.filter(s=>s.status==="live").length))}</div></div>`;

    document.getElementById("rows").innerHTML = stores.map(s => `
      <tr onclick="location.href='store-export.html?id=${encodeURIComponent(s.id)}&name=${encodeURIComponent(s.name)}'" style="cursor:pointer">
        <td><span class="sid">${s.id}</span></td>
        <td>${s.name}</td>
        <td>${OwnHub.money2(s.salesToday)}</td>
        <td>${OwnHub.money2(s.salesWeek)}</td>
        <td>${OwnHub.money2(s.royaltyDue)}</td>
        <td>${s.openOrders}</td>
        <td><span class="badge ${s.status}">${s.status}</span></td>
      </tr>`).join("");

    function downloadCsv() {
      const header = "storeId,name,salesToday,salesWeek,royaltyDue,openOrders,status";
      const body = stores.map(s => [s.id, s.name, s.salesToday, s.salesWeek, s.royaltyDue, s.openOrders, s.status].join(",")).join("\n");
      const blob = new Blob([header + "\n" + body], { type: "text/csv" });
      const a = document.createElement("a");
      a.href = URL.createObjectURL(blob);
      a.download = "ownhub-accounting.csv";
      a.click();
    }
  </script>
</body>
</html>
